{
  "name": "cairn-comments-vscode",
  "displayName": "Cairn Comments: Hide AI Comments",
  "description": "Stash the slop, keep the context. Keeps AI-written comments out of your code without losing them, and shows them as a toggleable overlay over the bare markers left in committed code.",
  "version": "0.1.0",
  "publisher": "cairn-comments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawls/cairn-comments.git",
    "directory": "packages/vscode"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai comments",
    "hide ai comments",
    "remove ai comments",
    "ai slop",
    "remove ai slop",
    "deslop",
    "hide comments",
    "comments",
    "comment overlay",
    "agent",
    "coding agent",
    "claude code",
    "codex",
    "cursor",
    "copilot",
    "sidecar",
    "git filter",
    "clean code"
  ],
  "activationEvents": [
    "workspaceContains:.agents/comments",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:csharp",
    "onLanguage:java",
    "onLanguage:kotlin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kotlin",
        "aliases": [
          "Kotlin"
        ],
        "extensions": [
          ".kt",
          ".kts"
        ]
      }
    ],
    "commands": [
      {
        "command": "cairn.toggleOverlay",
        "title": "Toggle AI Comment Overlay",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.editComment",
        "title": "Edit AI Comment",
        "category": "Cairn Comments",
        "icon": "$(edit)"
      },
      {
        "command": "cairn.confirmComment",
        "title": "Confirm AI Comment Is Still Accurate",
        "category": "Cairn Comments",
        "icon": "$(check)"
      },
      {
        "command": "cairn.promoteComment",
        "title": "Promote AI Comment to an Ordinary Comment",
        "category": "Cairn Comments",
        "icon": "$(arrow-up)"
      },
      {
        "command": "cairn.demoteComment",
        "title": "Demote Comment to an AI Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.deleteComment",
        "title": "Delete AI Comment",
        "category": "Cairn Comments",
        "icon": "$(trash)"
      },
      {
        "command": "cairn.saveComment",
        "title": "Save AI Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.cancelCommentEdit",
        "title": "Cancel",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.showComment",
        "title": "Show AI Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.refreshLists",
        "title": "Refresh AI Comment Lists",
        "category": "Cairn Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "cairn.reviewStale",
        "title": "Review Stale AI Comments",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.scan",
        "title": "Scan for AI Comments",
        "category": "Cairn Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "cairn.markSelectedAsAi",
        "title": "Mark Selected as AI Comments",
        "category": "Cairn Comments",
        "icon": "$(eye-closed)",
        "enablement": "cairn.reviewHasSelection"
      },
      {
        "command": "cairn.keepSelectedAsOrdinary",
        "title": "Keep Selected as Ordinary Comments",
        "category": "Cairn Comments",
        "icon": "$(comment)",
        "enablement": "cairn.reviewHasSelection"
      }
    ],
    "views": {
      "cairn": [
        {
          "id": "cairn.review",
          "name": "Review"
        },
        {
          "id": "cairn.stale",
          "name": "Possibly Stale"
        },
        {
          "id": "cairn.orphans",
          "name": "Orphaned"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cairn.toggleOverlay",
        "key": "ctrl+alt+`",
        "mac": "cmd+alt+`"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cairn.scan",
          "when": "view == cairn.review",
          "group": "navigation@1"
        },
        {
          "command": "cairn.markSelectedAsAi",
          "when": "view == cairn.review",
          "group": "navigation@2"
        },
        {
          "command": "cairn.keepSelectedAsOrdinary",
          "when": "view == cairn.review",
          "group": "navigation@3"
        },
        {
          "command": "cairn.refreshLists",
          "when": "view == cairn.stale || view == cairn.orphans",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cairn.editComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java || editorLangId == kotlin"
        },
        {
          "command": "cairn.confirmComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java || editorLangId == kotlin"
        },
        {
          "command": "cairn.promoteComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java || editorLangId == kotlin"
        },
        {
          "command": "cairn.demoteComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java || editorLangId == kotlin"
        },
        {
          "command": "cairn.deleteComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java || editorLangId == kotlin"
        },
        {
          "command": "cairn.saveComment",
          "when": "false"
        },
        {
          "command": "cairn.cancelCommentEdit",
          "when": "false"
        },
        {
          "command": "cairn.showComment",
          "when": "false"
        }
      ],
      "comments/comment/title": [
        {
          "command": "cairn.editComment",
          "when": "commentController == cairn.comments",
          "group": "inline@1"
        },
        {
          "command": "cairn.confirmComment",
          "when": "commentController == cairn.comments && comment == stale",
          "group": "inline@2"
        },
        {
          "command": "cairn.promoteComment",
          "when": "commentController == cairn.comments",
          "group": "inline@3"
        },
        {
          "command": "cairn.deleteComment",
          "when": "commentController == cairn.comments",
          "group": "inline@4"
        }
      ],
      "comments/comment/context": [
        {
          "command": "cairn.saveComment",
          "when": "commentController == cairn.comments",
          "group": "inline@1"
        },
        {
          "command": "cairn.cancelCommentEdit",
          "when": "commentController == cairn.comments",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Cairn Comments",
      "properties": {
        "cairn.overlayColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "CSS color for overlay text. Empty uses the theme's `editorCodeLens.foreground`; no theme color exposes the comment token color to decorations."
        },
        "cairn.ownLineStyle": {
          "type": "string",
          "enum": [
            "codelens",
            "thread",
            "eol"
          ],
          "default": "codelens",
          "markdownDescription": "How a comment on its own line renders in a file without markers: a CodeLens above the code line, an expanded comment thread, or a label at the end of the line above."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cairn",
          "title": "AI Comments",
          "icon": "media/cairn.svg"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "e2e": "node out/e2e/run.js",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && vsce package --no-dependencies -o cairn-comments.vsix"
  },
  "devDependencies": {
    "@cairn-comments/core": "0.0.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.97.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2"
  }
}
