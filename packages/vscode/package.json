{
  "name": "cairn-comments-vscode",
  "displayName": "Cairn Comments: Hide AI Comments",
  "description": "Stash the slop, keep the context. Keeps AI-written comments out of your code without losing them, and shows them as a toggleable overlay over the bare markers left in committed code.",
  "version": "0.1.0",
  "publisher": "cairn-comments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pawls/cairn-comments.git",
    "directory": "packages/vscode"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai comments",
    "hide ai comments",
    "remove ai comments",
    "ai slop",
    "remove ai slop",
    "deslop",
    "hide comments",
    "comments",
    "comment overlay",
    "agent",
    "coding agent",
    "claude code",
    "codex",
    "cursor",
    "copilot",
    "sidecar",
    "git filter",
    "clean code"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:csharp",
    "onLanguage:java"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cairn.toggleOverlay",
        "title": "Toggle AI Comment Overlay",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.editComment",
        "title": "Edit AI Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.confirmComment",
        "title": "Confirm AI Comment Is Still Accurate",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.promoteComment",
        "title": "Promote AI Comment to an Ordinary Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.demoteComment",
        "title": "Demote Comment to an AI Comment",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.reviewStale",
        "title": "Review Stale AI Comments",
        "category": "Cairn Comments"
      },
      {
        "command": "cairn.scan",
        "title": "Scan for AI Comments",
        "category": "Cairn Comments",
        "icon": "$(refresh)"
      },
      {
        "command": "cairn.applyReview",
        "title": "Apply AI Comment Review",
        "category": "Cairn Comments",
        "icon": "$(check-all)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cairn.review",
          "name": "AI Comment Review"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cairn.toggleOverlay",
        "key": "ctrl+alt+`",
        "mac": "cmd+alt+`"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cairn.scan",
          "when": "view == cairn.review",
          "group": "navigation@1"
        },
        {
          "command": "cairn.applyReview",
          "when": "view == cairn.review",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "cairn.editComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java"
        },
        {
          "command": "cairn.confirmComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java"
        },
        {
          "command": "cairn.promoteComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java"
        },
        {
          "command": "cairn.demoteComment",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == csharp || editorLangId == java"
        }
      ]
    },
    "configuration": {
      "title": "Cairn Comments",
      "properties": {
        "cairn.overlayColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "CSS color for overlay text. Empty uses the theme's `editorCodeLens.foreground`; no theme color exposes the comment token color to decorations."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "e2e": "node out/e2e/run.js",
    "package": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && vsce package --no-dependencies -o cairn-comments.vsix"
  },
  "devDependencies": {
    "@cairn-comments/core": "0.0.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.2"
  }
}
