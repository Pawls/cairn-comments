{
  "name": "tildenote-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && npm run bundle -w packages/vscode",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run packages/core packages/vscode",
    "test:integration": "npm run build && vitest run packages/cli",
    "test:vscode": "npm run build && npm run e2e -w packages/vscode"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
