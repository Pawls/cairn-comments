+TREE_AT_SEARCH = 4096  # cells `tree_at` may visit looking for the trunk
+
+
+def tree_at(world, cell: Cell) -> Tree | None:
+    """The tree whose fell would bring ``cell`` down, as `gather_tree` returns it for a strike
+    at the lowest cell of its trunk (lowest y, then x, then z). ``None`` for air and for a
+    cell that no tree's fell would take.
+
+    The trunk is searched for from ``cell`` over non-air cells, nearest first. A crown cell is
+    at most `CANOPY_REACH` canopy steps from its wood, but what RESTS on the crown is the
+    tree's however high it is stacked (`gather_tree`'s climb), so the search also starts from
+    every cell of the column ``cell`` stands on.
+    """
+    cell = (int(cell[0]), int(cell[1]), int(cell[2]))
+    at = world.block_at
+    if at(cell) is None:
+        return None
+    sources = [cell]
+    below = (cell[0], cell[1] - 1, cell[2])
+    while at(below) is not None and len(sources) < TREE_AT_SEARCH:
+        sources.append(below)
+        below = (below[0], below[1] - 1, below[2])
+    seen = set(sources)
+    frontier = sources
+    tried: set[Cell] = set()  # trunk cells already gathered
+    for _ in range(CANOPY_REACH + 1):
+        nxt: list[Cell] = []
+        for c in frontier:
+            ti = at(c)
+            if c not in tried and at((c[0], c[1] + 1, c[2])) == ti:
+                tree = gather_tree(world, c)
+                if tree is not None:
+                    tried.update(tree.trunk)
+                    low = min(tree.trunk, key=lambda t: (t[1], t[0], t[2]))
+                    if low != c:
+                        tree = gather_tree(world, low)
+                    if tree is not None and cell in tree.cells:
+                        return tree
+            for dx, dy, dz in _NEIGHBOURS:
+                n = (c[0] + dx, c[1] + dy, c[2] + dz)
+                if n in seen or at(n) is None or len(seen) >= TREE_AT_SEARCH:
+                    continue
+                seen.add(n)
+                nxt.append(n)
+        if not nxt:
+            break
+        frontier = nxt
+    return None
+
