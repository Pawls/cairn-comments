+    def _portal_frames_to_arrival(self, p) -> int | None:
+        """Frames until the walk-through would fire on ``p`` if the eye keeps last frame's move
+        (``portal.frames_to_cross``, with the margin ``update_portals`` uses for ``p``). None when
+        no move is known or ``p`` can never transfer (a window, or a target-less opening)."""
+        move = getattr(self, "_portal_last_move", None)
+        if move is None or not portal_mod.walkable(p) or not portal_mod.has_target(p):
+            return None
+        eye = tuple(self.camera.position)
+        return portal_mod.frames_to_cross(p, eye, move, margin=self._portal_cross_margin(p))
+
+    @staticmethod
+    def _portal_cross_margin(p) -> float:
+        """How far in front of ``p``'s plane the walk-through trigger sits, measured on the eye.
+
+        A FLOOR opening (axis 1, fall-through) triggers on the FEET, not the eye: falling, the
+        eye trails the feet by EYE_HEIGHT, so an eye trigger at the plane would sink the whole
+        body through the carved slab (and out its far side) first. Expressed as an eye margin:
+        fire when the eye is EYE_HEIGHT - CROSS_MARGIN above the plane, i.e. the feet are
+        CROSS_MARGIN below it, just inside the one-cell carve. Ceiling-up (and walls) keep the
+        standard margin: there the eye leads the body."""
+        if p.axis == 1 and p.sign < 0:
+            return physics.EYE_HEIGHT - PORTAL_CROSS_MARGIN
+        return PORTAL_CROSS_MARGIN
