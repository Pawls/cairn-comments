index 6c16f67d..b57e8f92 100644
--- a/portal.py
+++ b/portal.py
@@ -386,6 +386,41 @@ def crossed_through(p: Portal, prev, cur, eps: float = 0.0, margin: float = 0.0)
     return contains_point_on_plane(p, ix, iy, iz, eps)
 
 
+def _advance(point, step, frames: int):
+    return tuple(c + frames * d for c, d in zip(point, step, strict=True))
+
+
+def frames_to_cross(
+    p: Portal, eye, step, eps: float = 0.0, margin: float = 0.0, horizon: int = 600
+) -> int | None:
+    """How many frames until the walk-through trigger fires on ``p`` for an eye that starts at
+    ``eye`` and moves by ``step`` every frame: the first ``k >= 1`` for which
+    ``crossed_through(p, eye + (k - 1) * step, eye + k * step, eps, margin)`` holds, or None when
+    no frame up to ``horizon`` does.
+
+    Solved directly rather than stepped: the motion is a straight line, so it meets the trigger
+    plane at most once, and only the frame that straddles it can fire. A frame that ends exactly
+    on the plane fires (the trigger's straddle test is inclusive), so that frame is the answer."""
+    a = p.axis
+    speed = step[a]
+    if speed * p.sign <= 0:
+        return None  # not moving the through-way: no frame can fire
+    plane = p.plane - p.sign * margin
+    reach = (plane - eye[a]) / speed  # frames until the eye is on the trigger plane
+    if reach < 0:
+        return None  # already past the trigger plane
+    k = max(1, math.ceil(reach))
+    # Rounding can leave `k` one off the frame whose computed positions straddle the plane;
+    # settle it on the same arithmetic the trigger runs.
+    for frame in (k - 1, k, k + 1):
+        if frame < 1 or frame > horizon:
+            continue
+        prev, cur = _advance(eye, step, frame - 1), _advance(eye, step, frame)
+        if (prev[a] - plane) * (cur[a] - plane) <= 0:
+            return frame if crossed_through(p, prev, cur, eps, margin) else None
+    return None
+
+
