+def _walk_pairs(adj: dict[Cell, list[Cell]], cells) -> set[frozenset]:
+    """The walk edges touching ``cells``, as unordered pairs."""
+    return {frozenset((c, n)) for c in cells for n in adj.get(c, ())}
+
+
+def _edge_changes(walk_before, walk_after, ladders_before, ladders_after) -> dict:
+    climb_before = {frozenset((a, b)) for a, bs in ladders_before.items() for b in bs}
+    climb_after = {frozenset((a, b)) for a, bs in ladders_after.items() for b in bs}
+    return {
+        "walk_opened": walk_after - walk_before,
+        "walk_closed": walk_before - walk_after,
+        "climb_opened": climb_after - climb_before,
+        "climb_closed": climb_before - climb_after,
+    }
+
