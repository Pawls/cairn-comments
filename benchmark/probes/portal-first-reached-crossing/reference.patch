@@ -386,6 +386,15 @@ def crossed_through(p: Portal, prev, cur, eps: float = 0.0, margin: float = 0.0)
     return contains_point_on_plane(p, ix, iy, iz, eps)
 
 
+def crossing_fraction(p: Portal, prev, cur, margin: float = 0.0) -> float:
+    """How far along ``prev`` -> ``cur`` (0 at ``prev``, 1 at ``cur``) the segment meets the
+    trigger plane :func:`crossed_through` tests with the same ``margin``. Only meaningful for a
+    segment that crosses it."""
+    a = p.axis
+    plane = p.plane - p.sign * margin
+    return (plane - prev[a]) / (cur[a] - prev[a])
+
