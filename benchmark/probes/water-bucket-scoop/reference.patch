+def scoop(
+    is_open: IsOpen,
+    body: set[Cell],
+    count: int,
+    budget: int | None = None,
+    sources: frozenset[Cell] = frozenset(),
+) -> Drain:
+    """Take ``count`` cells of water out of a body at rest (the bucket): what is left stands
+    exactly as `solve_drain` leaves a body of that many cells in the same basin, ragged top
+    layer included. ``is_open`` is the plain "is this cell air" test, as for `solve_drain`.
+
+    A FED body (``sources``) refills as fast as it is scooped and comes back unchanged.
+    Scooping all of it or more empties it. ``bounded`` is False, with the body unchanged,
+    when the basin is too large to solve."""
+    if budget is None:
+        budget = DEFAULT_BUDGET
+    body = set(body)
+    if not body:
+        return Drain((), 0, (), (), None, 0, True)
+    top = max(c[1] for c in body) + 1
+    unchanged = Drain(tuple(sorted(body)), top, (), (), None, 0, True)
+    if count <= 0 or sources:
+        return unchanged
+    order = sorted(body, key=lambda c: (c[1], c[0], c[2]))
+    left = len(body) - count
+    if left <= 0:
+        return Drain((), order[0][1], tuple(order), (), None, 0, True)
+    # Re-solve a stand-in body of `left` cells. It keeps the lowest cell, which is the seed
+    # `solve_drain` floods from, and one cell of the top layer, so its flood still spans the
+    # whole basin; the cells scooped read as air.
+    stand_in = set(order[: left - 1]) | {order[-1]} if left > 1 else {order[0]}
+    drain = solve_drain(lambda c: c in body or is_open(c), stand_in, budget)
+    if not drain.bounded:
+        return Drain(unchanged.keep, top, (), (), None, 0, False)
+    keep = set(drain.keep)
+    return Drain(drain.keep, drain.level, tuple(sorted(body - keep)), (), None, 0, True)
+
