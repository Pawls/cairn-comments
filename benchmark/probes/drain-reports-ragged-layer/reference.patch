+    # The wet cells of the top layer when the solve left it only partly filled, in the order
+    # the solve chose them; empty when the top layer is whole.
+    ragged: tuple[Cell, ...] = ()
+
+
+def _ragged(chosen: list[Cell], candidates: list[Cell], keep: set[Cell]) -> tuple[Cell, ...]:
+    """The cells of a partial fill (``chosen``, in fill order, out of ``candidates``) that
+    stand in the top wet layer of ``keep``, when some candidate in that layer stays dry."""
+    if not chosen:
+        return ()
+    top = max(c[1] for c in keep)
+    taken = set(chosen)
+    if not any(c[1] == top and c not in taken for c in candidates):
+        return ()
+    return tuple(c for c in chosen if c[1] == top)
 
 
