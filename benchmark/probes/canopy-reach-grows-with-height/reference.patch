+def canopy_reach(trunk) -> int:
+    """How many canopy-flood steps a tree's crown may spread from its wood: `CANOPY_REACH`,
+    or a third of the trunk's height (lowest cell to highest) when that is more."""
+    ys = [c[1] for c in trunk]
+    return max(CANOPY_REACH, (max(ys) - min(ys) + 1) // 3)
